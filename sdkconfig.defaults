# ---- M5Stack Core2 hardware ----
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# Put anything bigger than 1 kB in the 8 MB PSRAM, keep 64 kB of fast RAM for Wi-Fi
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_FREERTOS_HZ=1000

# ---- Bigger app partition (OPC UA + graphics need > 1 MB) ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Stack / memory ----
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# ---- Networking for the OPC UA server ----
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_NETIF_LOOPBACK=y

# ---- Wi-Fi: 802.11r fast roaming (mesh routers that advertise FT-PSK) ----
CONFIG_ESP_WIFI_11R_SUPPORT=y

# ---- Battery: let the CPU slow down when idle (configured in app_main) ----
CONFIG_PM_ENABLE=y

# ---- Security: mbedTLS (RSA, certificates) uses PSRAM, keeping internal RAM ----
# ---- free for Wi-Fi and network sockets                                      ----
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
